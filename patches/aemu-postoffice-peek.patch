+#ifdef __EMSCRIPTEN__
+// emuflow-peek: o SOCKFS ignora MSG_PEEK, e recv tira os bytes da fila. O que foi espiado fica aqui.
+#include <pthread.h>
+#include <stdlib.h>
+#define PEEK_SLOTS 64
+#define PEEK_CAPACITY (64 * 1024)
+static struct { int fd; int len; char *data; } peek_slots[PEEK_SLOTS];
+static pthread_mutex_t peek_mutex = PTHREAD_MUTEX_INITIALIZER;
+static bool peek_ready = false;
+
+static int peek_slot(int fd, bool create) {
+	if (!peek_ready) {
+		for (int i = 0; i < PEEK_SLOTS; i++) peek_slots[i].fd = -1;
+		peek_ready = true;
+	}
+	for (int i = 0; i < PEEK_SLOTS; i++) if (peek_slots[i].fd == fd) return i;
+	if (!create) return -1;
+	for (int i = 0; i < PEEK_SLOTS; i++) {
+		if (peek_slots[i].fd == -1) {
+			peek_slots[i].fd = fd;
+			peek_slots[i].len = 0;
+			if (!peek_slots[i].data) peek_slots[i].data = (char *)malloc(PEEK_CAPACITY);
+			return i;
+		}
+	}
+	return -1;
+}
+#endif
